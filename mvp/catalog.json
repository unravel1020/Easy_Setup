    {
      "id": "git",
      "name": "Git",
      "category": "devops",
      "detect": "git",
      "verify": ["git --version"],
      "install": {
        "windows": "winget install --id Git.Git -e",
        "macos": "brew install git",
        "linux": "sudo apt install -y git"
      }
    },
    {
      "id": "node",
      "name": "Node.js",
      "category": "languages",
      "detect": "node",
      "verify": ["node --version"],
      "install": {
        "windows": "winget install --id OpenJS.NodeJS.LTS -e",
        "macos": "brew install node",
        "linux": "sudo apt install -y nodejs npm"
      }
    },
    {
      "id": "pnpm",
      "name": "pnpm",
      "category": "frontend",
