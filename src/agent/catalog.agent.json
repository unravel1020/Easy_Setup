  "recipes": [
    { "id": "git", "name": "Git", "command": "winget install --id Git.Git -e", "verify": "git --version" },
    { "id": "node", "name": "Node.js", "command": "winget install --id OpenJS.NodeJS.LTS -e", "verify": "node --version" },
    { "id": "pnpm", "name": "pnpm", "command": "corepack enable", "verify": "pnpm --version" },
    { "id": "python", "name": "Python", "command": "winget install --id Python.Python.3.12 -e", "verify": "python --version" },
    { "id": "go", "name": "Go", "command": "winget install --id GoLang.Go -e", "verify": "go version" },
    { "id": "rust", "name": "Rust", "command": "winget install --id Rustlang.Rustup -e", "verify": "rustc --version" },
    { "id": "java", "name": "Java JDK", "command": "winget install --id EclipseAdoptium.Temurin.21.JDK -e", "verify": "java -version" },
    { "id": "cpp", "name": "C/C++ Toolchain", "command": "winget install --id Kitware.CMake -e", "verify": "cmake --version" },
    { "id": "docker", "name": "Docker", "command": "winget install --id Docker.DockerDesktop -e", "verify": "docker --version" },
    { "id": "frontend.react", "name": "React", "command": "npm create vite@latest envforge-react-smoke -- --template react-ts", "verify": "node --version" },
    { "id": "frontend.vite", "name": "Vite", "command": "npm --version", "verify": "node --version" },
    { "id": "frontend.vue", "name": "Vue", "command": "npm create vue@latest", "verify": "node --version" },
    { "id": "frontend.electron", "name": "Electron", "command": "npm create electron-app@latest envforge-electron-smoke", "verify": "node --version" },
    { "id": "backend.spring", "name": "Spring Boot", "command": "winget install --id SpringSource.SpringToolSuite.4 -e", "verify": "java -version" },
    { "id": "backend.gin", "name": "Gin", "command": "go install github.com/gin-gonic/gin@latest", "verify": "go version" },
    { "id": "backend.fiber", "name": "Fiber", "command": "go env GOPATH", "verify": "go version" },
    { "id": "backend.echo", "name": "Echo", "command": "go env GOPATH", "verify": "go version" },
    { "id": "backend.axum", "name": "Axum", "command": "cargo search axum", "verify": "cargo --version" },
    { "id": "backend.actix", "name": "Actix", "command": "cargo search actix-web", "verify": "cargo --version" },
    { "id": "backend.fastapi", "name": "FastAPI", "command": "python -m pip install fastapi uvicorn", "verify": "python -c \"import fastapi; print(fastapi.__version__)\"" },
    { "id": "ai.pytorch", "name": "PyTorch", "command": "python -m pip install torch --index-url https://download.pytorch.org/whl/cpu", "verify": "python -c \"import torch; print(torch.__version__)\"" },
    { "id": "ai.transformers", "name": "Transformers", "command": "python -m pip install transformers datasets accelerate", "verify": "python -c \"import transformers; print(transformers.__version__)\"" },
    { "id": "ai.langchain", "name": "LangChain", "command": "python -m pip install langchain", "verify": "python -c \"import langchain; print(langchain.__version__)\"" },
    { "id": "ai.llamaindex", "name": "LlamaIndex", "command": "python -m pip install llama-index", "verify": "python -c \"import llama_index; print('llama-index ok')\"" },
    { "id": "notebook.jupyter", "name": "Jupyter", "command": "python -m pip install jupyterlab", "verify": "jupyter --version" },
    { "id": "testing.playwright", "name": "Playwright", "command": "npm init playwright@latest", "verify": "npx playwright --version" },
    { "id": "testing.pytest", "name": "pytest", "command": "python -m pip install pytest", "verify": "python -m pytest --version" },
    { "id": "testing.postman", "name": "Postman", "command": "winget install --id Postman.Postman -e", "verify": "postman --version" },
    { "id": "kubernetes.kubectl", "name": "kubectl", "command": "winget install --id Kubernetes.kubectl -e", "verify": "kubectl version --client" },
    { "id": "helm", "name": "Helm", "command": "winget install --id Helm.Helm -e", "verify": "helm version" },
    { "id": "terraform", "name": "Terraform", "command": "winget install --id Hashicorp.Terraform -e", "verify": "terraform version" },
    { "id": "ansible", "name": "Ansible", "command": "python -m pip install ansible", "verify": "ansible --version" },
    { "id": "skill.codex", "name": "Codex Skills", "command": "envforge notes skill.codex", "verify": "git --version" },
    { "id": "vibe.prototype", "name": "Vibe Prototype", "command": "envforge notes vibe.prototype", "verify": "git --version" },
    { "id": "harness.cli", "name": "Harness CLI", "command": "winget install --id Harness.HarnessCLI -e", "verify": "harness --version" },
    { "id": "linux.mirrors", "name": "Linux Mirrors", "command": "envforge configure mirrors --interactive", "verify": "git --version" },
    { "id": "vm.virtualbox", "name": "VirtualBox", "command": "winget install --id Oracle.VirtualBox -e", "verify": "VBoxManage --version" },
    { "id": "vm.vagrant", "name": "Vagrant", "command": "winget install --id Hashicorp.Vagrant -e", "verify": "vagrant --version" }
  ]
